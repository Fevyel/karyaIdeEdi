@import 'tailwindcss';

@source '../views';
@source '../../vendor/laravel/framework/src/Illuminate/Pagination/resources/views/*.blade.php';

@theme {
    --font-sans: 'Instrument Sans', ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';
    --font-display: 'Fraunces', ui-serif, Georgia, serif;

    /* Palet admin panel — furniture premium, versi upgrade untuk serah terima ke mitra.
       Nilai di bawah ini adalah tema GLOW (terang, default). Tema DARK mengoverride
       variabel yang sama lewat selector [data-theme="dark"] di bawah — karena semua
       halaman admin sudah konsisten memakai token ini (bukan warna hardcode), toggle
       tema bekerja otomatis tanpa perlu menyentuh markup tiap halaman. */
    --color-admin-canvas: #FAF8F4;
    --color-admin-surface: #FFFFFF;
    --color-admin-ink: #221A14;
    --color-admin-ink-soft: #756A5D;
    --color-admin-border: #E9E1D3;
    --color-admin-panel: #2A1B12;
    --color-admin-panel-soft: #6E655C;
    --color-admin-accent: #9C6B3F;
    --color-admin-accent-strong: #B9834C;
    --color-admin-cream: #F4EDE0;
    --color-admin-gold: #C9A566;
    --color-admin-success: #1E9E64;
    --color-admin-danger: #DC4C41;

    --animate-fade-in: fade-in .7s cubic-bezier(.16,1,.3,1) both;
    --animate-fade-in-up: fade-in-up .7s cubic-bezier(.16,1,.3,1) both;
}

@keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes fade-in-up {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
}

/* ==========================================================
   TEMA DARK — override variabel warna yang sama di atas.
   Diaktifkan lewat atribut data-theme="dark" di tag <html>
   (lihat resources/views/layouts/admin-panel.blade.php).
   Primary/accent & gold SENGAJA tidak diubah, supaya identitas
   warna kayu/coklat toko tetap terasa di kedua tema.
   ========================================================== */
[data-theme='dark'] {
    --color-admin-canvas: #16120D;
    --color-admin-surface: #221B14;
    --color-admin-ink: #F4EEE3;
    --color-admin-ink-soft: #AB9E8C;
    --color-admin-border: #3A2F23;
    --color-admin-cream: #2E2418;
}

/* Perpindahan tema yang halus, bukan langsung "meloncat". */
html[data-theme] * {
    transition-property: background-color, border-color, color, box-shadow;
    transition-duration: .35s;
    transition-timing-function: cubic-bezier(.4, 0, .2, 1);
}

/* Scrollbar tipis bernuansa kayu untuk area admin (sidebar, tabel, dsb). */
.admin-scroll {
    scrollbar-width: thin;
    scrollbar-color: var(--color-admin-accent) transparent;
}
.admin-scroll::-webkit-scrollbar {
    width: 6px;
    height: 6px;
}
.admin-scroll::-webkit-scrollbar-track {
    background: transparent;
}
.admin-scroll::-webkit-scrollbar-thumb {
    background-color: color-mix(in oklab, var(--color-admin-accent) 55%, transparent);
    border-radius: 999px;
}
.admin-scroll::-webkit-scrollbar-thumb:hover {
    background-color: var(--color-admin-accent);
}