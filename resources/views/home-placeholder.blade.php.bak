                    class="flex h-10 w-10 items-center justify-center rounded-full border border-[var(--color-admin-border)] text-[var(--color-admin-ink-soft)] transition-all duration-300 hover:border-[var(--color-admin-accent)] hover:text-[var(--color-admin-accent)] hover:shadow-md"
                    aria-label="Admin Panel"
                >
                    <i class="fa-solid fa-user text-sm"></i>
                </a>
                <span class="pointer-events-none absolute right-0 top-full mt-2 whitespace-nowrap rounded-md bg-[var(--color-admin-panel)] px-2.5 py-1.5 text-xs font-medium text-white opacity-0 shadow-lg transition-opacity duration-200 group-hover:opacity-100">
                    Admin Panel
                </span>
            </div>
        </header>

        {{-- ================= KONTEN ================= --}}
        <div class="flex min-h-[calc(100vh-73px)] items-center justify-center px-4">
